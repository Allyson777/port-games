# =========================================================================
# VARIÁVEIS DE AMBIENTE - PINA PORTS HUB SECURE
# =========================================================================

# URL do seu projeto Supabase (Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública/anônima (Project Settings > API > anon public)
# Esta chave PODE ir para o frontend
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave secreta de serviço (Project Settings > API > service_role secret)
# NUNCA exponha esta chave no navegador ou no frontend!
# Usada APENAS pelo backend server-side e Supabase Edge Functions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Porta do servidor backend (Padrão: 3000)
PORT=3000

